  },
  {
   "event": "GAP_DETECTED",
   "context": {
    "gap_minutes": 5
   },
   "expect_state": "HEALTHY"
  },
  {
   "event": "GAP_DETECTED",
   "context": {
    "gap_minutes": 20
   },
   "expect_state": "STALE"
  }
 ]
}
