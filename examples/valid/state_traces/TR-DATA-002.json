  },
  {
   "event": "CALENDAR_RESOLVED",
   "context": {
    "signed": true
   },
   "expect_state": "DEGRADED"
  },
  {
   "event": "QUOTE_UPDATE",
   "context": {
    "quote_age_s": 2,
    "xcheck_share": 0.99
   },
