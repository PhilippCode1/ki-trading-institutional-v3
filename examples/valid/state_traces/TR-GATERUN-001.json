  {
   "event": "RUN",
   "context": {},
   "expect_state": "RUNNING"
  },
  {
   "event": "FAIL_TECH",
   "context": {},
   "expect_state": "ERRORED"
  },
  {
   "event": "RERUN",
   "context": {
    "inputs_hash_unchanged": false
   },
   "expect_state": "ERRORED",
   "expect_invalid": true
  },
  {
   "event": "RERUN",
   "context": {
    "inputs_hash_unchanged": true
   },
   "expect_state": "RUNNING"
  },
  {
   "event": "RESULT",
   "context": {},
   "expect_state": "DECIDED"
  },
  {
   "event": "SIGN",
   "context": {
    "evaluator_key_valid": true
   },
   "expect_state": "SIGNED"
  },
  {
   "event": "ACK_SIGNED",
   "context": {
