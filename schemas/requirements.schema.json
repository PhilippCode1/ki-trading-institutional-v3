{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ki-trading-v3:requirements",
  "title": "Anforderungen",
  "x-version": "3.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "document": {
      "const": "Anforderungen"
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "status_values": {
      "type": "object"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[A-Z]+-\\d{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "pattern": "^BS-\\d{2}$"
          },
          "component": {
            "type": "string",
            "pattern": "^(C-[A-Z0-9]+|PKG)$"
          },
          "priority": {
            "enum": [
              "MUSS",
              "SOLL"
            ]
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "IM_PAKET_NACHGEWIESEN",
              "TEILWEISE_NACHGEWIESEN",
              "SPEZIFIZIERT"
            ]
          },
          "scenarios": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "title",
          "text",
          "basis",
          "stage",
          "component",
          "priority",
          "tests",
          "status",
          "scenarios"
        ],
        "additionalProperties": false
      },
      "minItems": 50
    }
  },
  "required": [
    "schema_version",
    "document",
    "as_of",
    "rule",
    "status_values",
    "requirements"
  ],
  "additionalProperties": false
}
