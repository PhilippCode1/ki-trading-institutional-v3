{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ki-trading-v3:traceability",
  "title": "Rückverfolgbarkeit",
  "x-version": "3.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "document": {
      "const": "Rückverfolgbarkeit (abgeleitet)"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "tests_known": {
            "type": "boolean"
          },
          "stage": {
            "type": "string",
            "pattern": "^BS-\\d{2}$"
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "tests",
          "tests_known",
          "stage",
          "status",
          "basis"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "tests_unreferenced": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "scenarios_without_test": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "parameters_unused": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "sources_unused": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "document",
    "requirements",
    "findings",
    "parameters_unused",
    "sources_unused"
  ],
  "additionalProperties": false
}
