{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ki-trading-v3:change_proposal",
  "title": "Änderungsvorschlag (create_proposal)",
  "description": "",
  "x-version": "3.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "urn:ki-trading-v3:common#/$defs/schema_version"
    },
    "message_id": {
      "$ref": "urn:ki-trading-v3:common#/$defs/uuid"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "$ref": "urn:ki-trading-v3:common#/$defs/producer"
    },
    "created_utc": {
      "$ref": "urn:ki-trading-v3:common#/$defs/utc"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "author_role": {
      "enum": [
        "HERMES",
        "BETREIBER"
      ]
    },
    "suggested_class": {
      "enum": [
        "A0",
        "A1",
        "B",
        "C",
        "D"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "affected_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "status": {
      "enum": [
        "OFFEN",
        "ANGENOMMEN",
        "ABGELEHNT"
      ]
    }
  },
  "required": [
    "schema_version",
    "message_id",
    "correlation_id",
    "producer",
    "created_utc",
    "proposal_id",
    "title",
    "author_role",
    "suggested_class",
    "rationale",
    "affected_paths",
    "evidence_refs",
    "status"
  ],
  "additionalProperties": false
}
