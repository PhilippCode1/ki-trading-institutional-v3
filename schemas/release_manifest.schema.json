{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ki-trading-v3:release_manifest",
  "title": "Release-Manifest (IF-11, SM-RELEASE)",
  "description": "Autor ≠ Prüfer (Beispielregel R-EX-06); Karenzzeit P-OPS-CHANGE-COOLDOWN-H zwischen Prüfbericht und Freigabe der Klassen C und D.",
  "x-version": "3.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "urn:ki-trading-v3:common#/$defs/schema_version"
    },
    "message_id": {
      "$ref": "urn:ki-trading-v3:common#/$defs/uuid"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "$ref": "urn:ki-trading-v3:common#/$defs/producer"
    },
    "created_utc": {
      "$ref": "urn:ki-trading-v3:common#/$defs/utc"
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "change_class": {
      "enum": [
        "A0",
        "A1",
        "B",
        "C",
        "D"
      ]
    },
    "artifact_sha256": {
      "$ref": "urn:ki-trading-v3:common#/$defs/sha256"
    },
    "sbom_sha256": {
      "$ref": "urn:ki-trading-v3:common#/$defs/sha256"
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "author_key": {
      "$ref": "urn:ki-trading-v3:common#/$defs/key_fingerprint"
    },
    "reviewer_key": {
      "$ref": "urn:ki-trading-v3:common#/$defs/key_fingerprint"
    },
    "review_report_utc": {
      "$ref": "urn:ki-trading-v3:common#/$defs/utc"
    },
    "approval_utc": {
      "$ref": "urn:ki-trading-v3:common#/$defs/utc"
    },
    "second_approval_key": {
      "$ref": "urn:ki-trading-v3:common#/$defs/key_fingerprint"
    },
    "equivalence": {
      "enum": [
        "GLEICH",
        "ERKLAERT",
        "ABWEICHEND"
      ]
    },
    "ci_python_versions": {
      "type": "array",
      "items": {
        "enum": [
          "3.11",
          "3.12",
          "3.13"
        ]
      },
      "minItems": 3,
      "uniqueItems": true
    },
    "warnings_as_errors": {
      "const": true
    },
    "is_agent_update": {
      "type": "boolean"
    },
    "eval_pass_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "signature": {
      "$ref": "urn:ki-trading-v3:common#/$defs/signature"
    }
  },
  "required": [
    "schema_version",
    "message_id",
    "correlation_id",
    "producer",
    "created_utc",
    "release_id",
    "change_class",
    "artifact_sha256",
    "sbom_sha256",
    "provenance",
    "author_key",
    "reviewer_key",
    "review_report_utc",
    "approval_utc",
    "equivalence",
    "ci_python_versions",
    "warnings_as_errors",
    "is_agent_update",
    "signature"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "change_class": {
            "enum": [
              "C",
              "D"
            ]
          }
        },
        "required": [
          "change_class"
        ]
      },
      "then": {
        "required": [
          "second_approval_key"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "change_class": {
            "enum": [
              "A0",
              "A1",
              "B"
            ]
          }
        },
        "required": [
          "change_class"
        ]
      },
      "then": {
        "required": [],
        "properties": {
          "equivalence": {
            "const": "GLEICH"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "is_agent_update": {
            "const": true
          }
        },
        "required": [
          "is_agent_update"
        ]
      },
      "then": {
        "required": [
          "eval_pass_rate"
        ]
      }
    }
  ]
}
