{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ki-trading-v3:model_inventory",
  "title": "Modellinventar",
  "x-version": "3.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "document": {
      "const": "Modellinventar (SR 11-7)"
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MOD-[A-Z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "RECHNER",
              "STRATEGIE",
              "ML",
              "RISIKOMODELL"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "materiality": {
            "enum": [
              "HOCH",
              "MITTEL",
              "GERING"
            ]
          },
          "validation_status": {
            "enum": [
              "REFERENZ_GETESTET",
              "SPEZIFIZIERT",
              "GEPLANT"
            ]
          },
          "limitations": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "independent_validation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "purpose",
          "file",
          "tests",
          "materiality",
          "validation_status",
          "limitations",
          "owner",
          "independent_validation"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "document",
    "as_of",
    "models"
  ],
  "additionalProperties": false
}
