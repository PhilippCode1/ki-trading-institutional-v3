{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ki-trading-v3:drill_register",
  "title": "Drill-Register",
  "x-version": "3.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "document": {
      "const": "Drill-Register"
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "drills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^DR-\\d{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "interval": {
            "type": "string",
            "minLength": 1
          },
          "gate": {
            "type": "string",
            "pattern": "^(GATE-G([0-9]|10)|MON-[A-Z]+)$"
          },
          "procedure": {
            "type": "string",
            "minLength": 1
          },
          "pass": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "interval",
          "gate",
          "procedure",
          "pass"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "document",
    "as_of",
    "rule",
    "drills"
  ],
  "additionalProperties": false
}
