{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ki-trading-v3:build_stages",
  "title": "Bauprogramm",
  "x-version": "3.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "document": {
      "const": "Bauprogramm"
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "estimation_basis": {
      "type": "object"
    },
    "critical_path": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^BS-\\d{2}$"
      },
      "minItems": 1
    },
    "parallel": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^BS-\\d{2}$"
        },
        "minItems": 2
      },
      "minItems": 0
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^BS-\\d{2}$"
          },
          "gate": {
            "type": "string",
            "pattern": "^(GATE-G([0-9]|10)|MON-[A-Z]+)$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "type": "object",
            "properties": {
              "low": {
                "type": "object",
                "properties": {
                  "agent_days": {
                    "type": "number",
                    "minimum": 0
                  },
                  "person_days": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "agent_days",
                  "person_days"
                ],
                "additionalProperties": false
              },
              "base": {
                "type": "object",
                "properties": {
                  "agent_days": {
                    "type": "number",
                    "minimum": 0
                  },
                  "person_days": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "agent_days",
                  "person_days"
                ],
                "additionalProperties": false
              },
              "high": {
                "type": "object",
                "properties": {
                  "agent_days": {
                    "type": "number",
                    "minimum": 0
                  },
                  "person_days": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "agent_days",
                  "person_days"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "low",
              "base",
              "high"
            ],
            "additionalProperties": false
          },
          "external": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^X-"
            },
            "minItems": 0
          },
          "duration_weeks": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^BS-\\d{2}$"
            },
            "minItems": 0
          },
          "dod": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "cost_items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^C-[A-Z0-9]+$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "kloc": {
                  "type": "number"
                }
              },
              "required": [
                "id",
                "name",
                "kloc"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "gate",
          "name",
          "effort",
          "external",
          "duration_weeks",
          "depends_on",
          "dod",
          "cost_items"
        ],
        "additionalProperties": false
      },
      "minItems": 11
    }
  },
  "required": [
    "schema_version",
    "document",
    "as_of",
    "estimation_basis",
    "critical_path",
    "parallel",
    "stages"
  ],
  "additionalProperties": false
}
