{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ki-trading-v3:scorecard_E",
  "title": "Evidenz-Score E",
  "x-version": "3.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "document": {
      "const": "Evidenz-Score E – Selbstbewertung nach §20.3"
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "self_assessment": {
      "const": true
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E-[1-9]$"
          },
          "max": {
            "type": "number"
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^GATE-G([0-9]|10)$"
            },
            "minItems": 1
          },
          "points": {
            "type": "number"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "max",
          "requirement",
          "gates",
          "points",
          "evidence",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 9
    },
    "total": {
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "document",
    "as_of",
    "self_assessment",
    "rule",
    "blocks",
    "total"
  ],
  "additionalProperties": false
}
