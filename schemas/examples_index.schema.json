{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ki-trading-v3:examples_index",
  "title": "Beispielverzeichnis",
  "x-version": "3.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "document": {
      "const": "Beispielverzeichnis"
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^examples/(valid/contracts|invalid)/[a-z0-9_]+\\.json$"
          },
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "valid": {
            "type": "boolean"
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "SCHEMA",
                  "SEMANTIC"
                ]
              },
              "rule": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^R-EX-\\d{2}$"
              }
            },
            "required": [
              "type",
              "rule"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "file",
          "schema",
          "valid",
          "note"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "document",
    "as_of",
    "rule",
    "examples"
  ],
  "additionalProperties": false
}
