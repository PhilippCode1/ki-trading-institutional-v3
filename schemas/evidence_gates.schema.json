{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ki-trading-v3:evidence_gates",
  "title": "Evidenztore",
  "x-version": "3.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "document": {
      "const": "Evidenztore und Monitore (führende Quelle der Torregeln)"
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "leading_source_for": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string",
      "minLength": 1
    },
    "outcome_classes": {
      "type": "object",
      "properties": {
        "PASS": {
          "type": "string",
          "minLength": 1
        },
        "FAIL": {
          "type": "string",
          "minLength": 1
        },
        "INCONCLUSIVE": {
          "type": "string",
          "minLength": 1
        },
        "INVALID": {
          "type": "string",
          "minLength": 1
        },
        "ERROR": {
          "type": "string",
          "minLength": 1
        },
        "BLOCKED_EXTERNAL": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "INVALID",
        "ERROR",
        "BLOCKED_EXTERNAL"
      ],
      "additionalProperties": false
    },
    "evaluation": {
      "type": "string",
      "minLength": 1
    },
    "e_score_map": {
      "type": "object"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(GATE-G([0-9]|10)|MON-[A-Z]+)$"
          },
          "kind": {
            "enum": [
              "GATE",
              "MONITOR"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "pattern": "^BS-\\d{2}$"
          },
          "e_block": {
            "type": [
              "string",
              "null"
            ]
          },
          "cost_effect": {
            "type": "string",
            "minLength": 1
          },
          "evidence_class": {
            "type": "string",
            "minLength": 1
          },
          "oc_model": {
            "type": "string",
            "minLength": 1
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "expr": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 1
                },
                "on_fail": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "INCONCLUSIVE",
                    "INVALID",
                    "ERROR",
                    "BLOCKED_EXTERNAL"
                  ]
                }
              },
              "required": [
                "id",
                "description",
                "expr",
                "on_fail"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "type": {
                  "enum": [
                    "integer",
                    "number",
                    "boolean",
                    "string"
                  ]
                },
                "unit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "type",
                "unit",
                "source"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "computations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "expr": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "expr",
                "description"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "outcome_rules": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "outcome": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "INCONCLUSIVE",
                    "INVALID",
                    "ERROR",
                    "BLOCKED_EXTERNAL"
                  ]
                },
                "when": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "outcome",
                "when",
                "reason"
              ],
              "additionalProperties": false
            },
            "minItems": 2
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]+$"
                },
                "when": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "when",
                "description"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "next_steps": {
            "type": "object",
            "properties": {
              "PASS": {
                "type": "string",
                "minLength": 1
              },
              "FAIL": {
                "type": "string",
                "minLength": 1
              },
              "INCONCLUSIVE": {
                "type": "string",
                "minLength": 1
              },
              "INVALID": {
                "type": "string",
                "minLength": 1
              },
              "ERROR": {
                "type": "string",
                "minLength": 1
              },
              "BLOCKED_EXTERNAL": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "PASS",
              "FAIL",
              "INCONCLUSIVE",
              "INVALID",
              "ERROR",
              "BLOCKED_EXTERNAL"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "purpose",
          "stage",
          "e_block",
          "cost_effect",
          "evidence_class",
          "prerequisites",
          "inputs",
          "computations",
          "outcome_rules",
          "flags",
          "next_steps"
        ],
        "additionalProperties": false
      },
      "minItems": 11
    }
  },
  "required": [
    "schema_version",
    "document",
    "as_of",
    "leading_source_for",
    "origin",
    "outcome_classes",
    "evaluation",
    "e_score_map",
    "gates"
  ],
  "additionalProperties": false
}
