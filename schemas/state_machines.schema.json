{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ki-trading-v3:state_machines",
  "title": "Zustandsautomaten",
  "x-version": "3.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "document": {
      "const": "Zustandsautomaten des Zielsystems"
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "leading_source_for": {
      "type": "string",
      "minLength": 1
    },
    "expression_language": {
      "type": "string",
      "minLength": 1
    },
    "semantics": {
      "type": "object",
      "properties": {
        "FSM": {
          "type": "string",
          "minLength": 1
        },
        "LATTICE": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "FSM",
        "LATTICE"
      ],
      "additionalProperties": false
    },
    "origin": {
      "type": "string",
      "minLength": 1
    },
    "operator_event_actions": {
      "type": "object"
    },
    "operator_actions_outside_machines": {
      "type": "object"
    },
    "machines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SM-[A-Z]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "FSM",
              "LATTICE"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "authoritative_owner": {
            "type": "string",
            "minLength": 1
          },
          "persistence": {
            "type": "string",
            "minLength": 1
          },
          "initial": {
            "type": "string",
            "minLength": 1
          },
          "states": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "terminal": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "description",
                "terminal"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "source",
                "description"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "from": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "event": {
                  "type": "string",
                  "minLength": 1
                },
                "guard": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 1
                },
                "to": {
                  "type": "string",
                  "minLength": 1
                },
                "authorization": {
                  "type": "string",
                  "minLength": 1
                },
                "effect": {
                  "type": "string",
                  "minLength": 1
                },
                "side_effect": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "from",
                "event",
                "guard",
                "to",
                "authorization",
                "effect",
                "side_effect"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "invalid_event_policy": {
            "enum": [
              "IGNORE_AND_LOG",
              "REJECT_AND_LOG_SECURITY_EVENT",
              "BROKER_FACT_WINS_INCIDENT_AND_SYNC"
            ]
          },
          "invariants": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "broker_fact_sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "broker_fact_target": {
            "type": "string",
            "minLength": 1
          },
          "broker_fact_exempt_states": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "not_applicable": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "minLength": 1
                },
                "event": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "state",
                "event",
                "reason"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "order_kind_permissions": {
            "type": "object"
          },
          "broker_mapping": {
            "type": "object"
          },
          "risk_scale": {
            "type": "object"
          },
          "levels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "level_rank": {
            "type": "object"
          },
          "reason_classes": {
            "type": "object"
          },
          "actions": {
            "type": "object"
          },
          "protection_base": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "protection_base_excluded_levels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "required_in_every_combination": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "action_implications": {
            "type": "object"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                },
                "level": {
                  "type": "string",
                  "minLength": 1
                },
                "class": {
                  "type": "string",
                  "minLength": 1
                },
                "set_events": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "clear_events": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "clear_guard": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "level",
                "class",
                "set_events",
                "clear_events",
                "clear_guard",
                "description"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "allowed_actions": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "question",
          "authoritative_owner",
          "persistence",
          "initial",
          "states",
          "events",
          "transitions",
          "invalid_event_policy",
          "invariants"
        ],
        "additionalProperties": false
      },
      "minItems": 14
    }
  },
  "required": [
    "schema_version",
    "document",
    "as_of",
    "leading_source_for",
    "expression_language",
    "semantics",
    "origin",
    "operator_event_actions",
    "operator_actions_outside_machines",
    "machines"
  ],
  "additionalProperties": false
}
