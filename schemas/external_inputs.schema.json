{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ki-trading-v3:external_inputs",
  "title": "Externe Eingaben",
  "x-version": "3.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "document": {
      "const": "Externe Eingaben mit Sperrwirkung"
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "block_targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^X-[A-Z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "UNBESTAETIGT",
              "BESTAETIGT",
              "ABGELEHNT"
            ]
          },
          "default_value": {},
          "default_marked": {
            "type": "boolean"
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "evidence_required": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "owner",
          "status",
          "default_value",
          "default_marked",
          "blocks",
          "evidence_required",
          "refs",
          "note"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "document",
    "as_of",
    "rules",
    "block_targets",
    "inputs"
  ],
  "additionalProperties": false
}
