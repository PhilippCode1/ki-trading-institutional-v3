{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ki-trading-v3:source_register",
  "title": "Quellenregister",
  "x-version": "3.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "document": {
      "const": "Quellenregister"
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status_values": {
      "type": "object"
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SRC-[A-Z0-9]+(-[A-Z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "urls": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^https?://"
            },
            "minItems": 0
          },
          "retrieved": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "status": {
            "enum": [
              "BELEGT",
              "TEILWEISE",
              "NICHT_GEPRUEFT"
            ]
          },
          "status_detail": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "supports": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "limits": {
            "type": "string"
          },
          "used_in": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "urls",
          "retrieved",
          "status",
          "status_detail",
          "origin",
          "supports",
          "evidence",
          "used_in"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "document",
    "as_of",
    "status_values",
    "method",
    "sources"
  ],
  "additionalProperties": false
}
