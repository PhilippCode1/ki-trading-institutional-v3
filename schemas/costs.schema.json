{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ki-trading-v3:costs",
  "title": "Kosten- und Gebührentabelle",
  "x-version": "3.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "document": {
      "const": "Kosten- und Gebührentabelle"
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "costs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^COST-[A-Z0-9-]+$"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "amount": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d+)?$"
          },
          "currency": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "BELEGT",
              "TEILWEISE",
              "ANNAHME",
              "ENTWURF"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "external_input": {
            "type": "string",
            "pattern": "^X-"
          }
        },
        "required": [
          "id",
          "category",
          "name",
          "amount",
          "currency",
          "unit",
          "status",
          "source",
          "scenario",
          "note"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "document",
    "as_of",
    "rules",
    "costs"
  ],
  "additionalProperties": false
}
