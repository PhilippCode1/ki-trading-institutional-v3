{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ki-trading-v3:live_grant",
  "title": "Grant (IF-05, SM-GRANT)",
  "description": "Laufzeit höchstens P-SEC-GRANT-DAYS je Art (Beispielregel R-EX-03).",
  "x-version": "3.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "urn:ki-trading-v3:common#/$defs/schema_version"
    },
    "message_id": {
      "$ref": "urn:ki-trading-v3:common#/$defs/uuid"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "enum": [
        "GRANT_REGISTRY"
      ],
      "description": "Geldpfad: nur Geldpfad-Komponenten als Erzeuger (R-05)"
    },
    "created_utc": {
      "$ref": "urn:ki-trading-v3:common#/$defs/utc"
    },
    "grant_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "PAPER",
        "PILOT",
        "STANDARD"
      ]
    },
    "key_fingerprint": {
      "$ref": "urn:ki-trading-v3:common#/$defs/key_fingerprint"
    },
    "broker": {
      "type": "string",
      "minLength": 1
    },
    "account_ref": {
      "$ref": "urn:ki-trading-v3:common#/$defs/account_ref"
    },
    "account_type": {
      "$ref": "urn:ki-trading-v3:common#/$defs/account_type"
    },
    "instruments": {
      "type": "array",
      "items": {
        "$ref": "urn:ki-trading-v3:common#/$defs/instrument_id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "release_sha256": {
      "$ref": "urn:ki-trading-v3:common#/$defs/sha256"
    },
    "strategy_sha256": {
      "$ref": "urn:ki-trading-v3:common#/$defs/sha256"
    },
    "parameters_sha256": {
      "$ref": "urn:ki-trading-v3:common#/$defs/sha256"
    },
    "capital_cap": {
      "$ref": "urn:ki-trading-v3:common#/$defs/money"
    },
    "loss_budget": {
      "$ref": "urn:ki-trading-v3:common#/$defs/money"
    },
    "profile": {
      "anyOf": [
        {
          "$ref": "urn:ki-trading-v3:common#/$defs/profile"
        },
        {
          "type": "null"
        }
      ]
    },
    "valid_from_utc": {
      "$ref": "urn:ki-trading-v3:common#/$defs/utc"
    },
    "valid_until_utc": {
      "$ref": "urn:ki-trading-v3:common#/$defs/utc"
    },
    "alert_channels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "revocation_id": {
      "type": "string",
      "minLength": 1
    },
    "gates_passed": {
      "type": "array",
      "items": {
        "$ref": "urn:ki-trading-v3:common#/$defs/gate_id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "risk_acceptance_ref": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "$ref": "urn:ki-trading-v3:common#/$defs/signature"
    }
  },
  "required": [
    "schema_version",
    "message_id",
    "correlation_id",
    "producer",
    "created_utc",
    "grant_id",
    "kind",
    "key_fingerprint",
    "broker",
    "account_ref",
    "account_type",
    "instruments",
    "release_sha256",
    "strategy_sha256",
    "parameters_sha256",
    "capital_cap",
    "loss_budget",
    "profile",
    "valid_from_utc",
    "valid_until_utc",
    "alert_channels",
    "revocation_id",
    "gates_passed",
    "signature"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "PAPER"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [],
        "properties": {
          "account_type": {
            "const": "DEMO"
          },
          "gates_passed": {
            "contains": {
              "const": "GATE-G6"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "PILOT"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "risk_acceptance_ref"
        ],
        "properties": {
          "account_type": {
            "const": "REAL"
          },
          "profile": {
            "const": "H5"
          },
          "gates_passed": {
            "contains": {
              "const": "GATE-G7"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "STANDARD"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "risk_acceptance_ref"
        ],
        "properties": {
          "account_type": {
            "const": "REAL"
          },
          "profile": {
            "$ref": "urn:ki-trading-v3:common#/$defs/profile"
          },
          "gates_passed": {
            "contains": {
              "const": "GATE-G8"
            }
          }
        }
      }
    }
  ]
}
