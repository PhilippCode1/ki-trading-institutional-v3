{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ki-trading-v3:test_catalog",
  "title": "Testkatalog",
  "x-version": "3.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "document": {
      "const": "Testkatalog"
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "execution_values": {
      "type": "object"
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(KT-\\d{2}|T-[A-Z0-9]+(-[A-Z0-9]+)*-\\d{3})$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "enum": [
              "UNIT",
              "PROPERTY",
              "SIMULATION",
              "INTEGRATION",
              "BROKER_CERT",
              "LOAD",
              "SOAK",
              "CHAOS",
              "FAULT_INJECTION",
              "MUTATION",
              "SECURITY",
              "DRILL",
              "STATIC"
            ]
          },
          "component": {
            "type": "string",
            "pattern": "^(C-[A-Z0-9]+|PKG)$"
          },
          "stage": {
            "type": "string",
            "pattern": "^BS-\\d{2}$"
          },
          "gate": {
            "type": "string",
            "pattern": "^(GATE-G([0-9]|10)|MON-[A-Z]+)$"
          },
          "procedure": {
            "type": "string",
            "minLength": 1
          },
          "oracle": {
            "type": "string",
            "minLength": 1
          },
          "pass_criterion": {
            "type": "string",
            "minLength": 1
          },
          "execution": {
            "enum": [
              "IM_PAKET",
              "BROKER",
              "BAU",
              "BETRIEB"
            ]
          },
          "automation": {
            "enum": [
              "AUTOMATISCH",
              "HALBAUTOMATISCH",
              "MANUELL"
            ]
          },
          "params": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^P-[A-Z0-9]+(-[A-Z0-9]+)+$"
            },
            "minItems": 0
          },
          "status": {
            "enum": [
              "IM_PAKET_AUSGEFUEHRT",
              "SPEZIFIZIERT"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "fallback": {
            "type": "string",
            "minLength": 1
          },
          "failure_effect": {
            "type": "string",
            "minLength": 1
          },
          "account": {
            "type": "string",
            "minLength": 1
          },
          "killer_first_rank": {
            "type": "integer",
            "minimum": 1
          },
          "drill": {
            "type": "string",
            "pattern": "^DR-\\d{2}$"
          },
          "interval": {
            "type": "string",
            "minLength": 1
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "scenarios": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "title",
          "level",
          "component",
          "stage",
          "gate",
          "procedure",
          "oracle",
          "pass_criterion",
          "execution",
          "automation",
          "params",
          "status",
          "requirements",
          "scenarios"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "execution": {
                  "const": "IM_PAKET"
                }
              }
            },
            "then": {
              "required": [
                "evidence"
              ],
              "properties": {
                "status": {
                  "const": "IM_PAKET_AUSGEFUEHRT"
                }
              }
            },
            "else": {
              "properties": {
                "status": {
                  "const": "SPEZIFIZIERT"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "level": {
                  "const": "BROKER_CERT"
                }
              }
            },
            "then": {
              "required": [
                "fallback",
                "failure_effect",
                "account",
                "killer_first_rank"
              ]
            }
          }
        ]
      },
      "minItems": 100
    }
  },
  "required": [
    "schema_version",
    "document",
    "as_of",
    "rule",
    "levels",
    "execution_values",
    "tests"
  ],
  "additionalProperties": false
}
