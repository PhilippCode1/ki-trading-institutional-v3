{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ki-trading-v3:risk_register",
  "title": "Risikoregister",
  "x-version": "3.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "document": {
      "const": "Risikoregister"
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "scale": {
      "type": "string",
      "minLength": 1
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RK-\\d{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "cause": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "type": "string",
            "minLength": 1
          },
          "likelihood": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "impact": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "score": {
            "type": "integer"
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "residual": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "masterprompt_ref": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "status": {
            "enum": [
              "OFFEN",
              "BEHANDELT",
              "AKZEPTIERT"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "category",
          "cause",
          "effect",
          "likelihood",
          "impact",
          "score",
          "controls",
          "residual",
          "owner",
          "masterprompt_ref",
          "refs",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 7
    }
  },
  "required": [
    "schema_version",
    "document",
    "as_of",
    "scale",
    "risks"
  ],
  "additionalProperties": false
}
