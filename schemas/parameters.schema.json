{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ki-trading-v3:parameters",
  "title": "Parameterregister",
  "x-version": "3.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "document": {
      "const": "Parameterregister"
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status_values": {
      "type": "object"
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P-[A-Z0-9]+(-[A-Z0-9]+)+$"
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "BETREIBER",
              "BELEGT",
              "ENTWURF",
              "ANNAHME",
              "ABGELEITET"
            ]
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9]*(-[A-Za-z0-9_{}]+)+$"
            },
            "minItems": 0
          },
          "recalibration": {
            "type": "string",
            "minLength": 1
          },
          "external_input": {
            "type": "string",
            "pattern": "^X-"
          },
          "used_in": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "group",
          "name",
          "value",
          "unit",
          "status",
          "basis",
          "refs",
          "used_in"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "document",
    "as_of",
    "status_values",
    "parameters"
  ],
  "additionalProperties": false
}
