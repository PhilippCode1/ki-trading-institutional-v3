{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ki-trading-v3:incident",
  "title": "Incident (IF-12, SM-INCIDENT)",
  "description": "",
  "x-version": "3.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "urn:ki-trading-v3:common#/$defs/schema_version"
    },
    "message_id": {
      "$ref": "urn:ki-trading-v3:common#/$defs/uuid"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "$ref": "urn:ki-trading-v3:common#/$defs/producer"
    },
    "created_utc": {
      "$ref": "urn:ki-trading-v3:common#/$defs/utc"
    },
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "NIEDRIG",
        "MITTEL",
        "HOCH",
        "KRITISCH"
      ]
    },
    "state": {
      "enum": [
        "OPEN",
        "TRIAGED",
        "MITIGATED",
        "RESOLVED",
        "CLOSED"
      ]
    },
    "opened_utc": {
      "$ref": "urn:ki-trading-v3:common#/$defs/utc"
    },
    "runbook": {
      "type": "string",
      "pattern": "^RB-\\d{2}$"
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time_utc": {
            "$ref": "urn:ki-trading-v3:common#/$defs/utc"
          },
          "entry": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "time_utc",
          "entry"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "cause": {
      "type": "string",
      "minLength": 1
    },
    "postmortem_ref": {
      "type": "string",
      "minLength": 1
    },
    "closed_utc": {
      "$ref": "urn:ki-trading-v3:common#/$defs/utc"
    },
    "safety_reasons": {
      "type": "array",
      "items": {
        "$ref": "urn:ki-trading-v3:common#/$defs/safety_reason"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "message_id",
    "correlation_id",
    "producer",
    "created_utc",
    "incident_id",
    "severity",
    "state",
    "opened_utc",
    "runbook",
    "timeline",
    "safety_reasons"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "RESOLVED",
              "CLOSED"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "cause"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "CLOSED"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "closed_utc"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "RESOLVED",
              "CLOSED"
            ]
          },
          "severity": {
            "enum": [
              "HOCH",
              "KRITISCH"
            ]
          }
        },
        "required": [
          "state",
          "severity"
        ]
      },
      "then": {
        "required": [
          "postmortem_ref"
        ]
      }
    }
  ]
}
