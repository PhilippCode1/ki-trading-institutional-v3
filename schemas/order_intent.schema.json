{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ki-trading-v3:order_intent",
  "title": "Handelsabsicht (IF-01)",
  "description": "Schließen nur mit position_ticket (kein freier Gegenauftrag im Hedging-Konto); Einstiege mit Gültigkeit ORDER_TIME_SPECIFIED für den Negativnachweis.",
  "x-version": "3.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "urn:ki-trading-v3:common#/$defs/schema_version"
    },
    "message_id": {
      "$ref": "urn:ki-trading-v3:common#/$defs/uuid"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "enum": [
        "TRADE_CORE"
      ],
      "description": "Geldpfad: nur Geldpfad-Komponenten als Erzeuger (R-05)"
    },
    "created_utc": {
      "$ref": "urn:ki-trading-v3:common#/$defs/utc"
    },
    "command_id": {
      "$ref": "urn:ki-trading-v3:common#/$defs/command_id"
    },
    "payload_sha256": {
      "$ref": "urn:ki-trading-v3:common#/$defs/sha256"
    },
    "account_ref": {
      "$ref": "urn:ki-trading-v3:common#/$defs/account_ref"
    },
    "mode": {
      "$ref": "urn:ki-trading-v3:common#/$defs/trading_mode"
    },
    "instrument_id": {
      "$ref": "urn:ki-trading-v3:common#/$defs/instrument_id"
    },
    "broker_symbol": {
      "type": "string",
      "minLength": 1
    },
    "strategy_id": {
      "$ref": "urn:ki-trading-v3:common#/$defs/strategy_id"
    },
    "order_kind": {
      "enum": [
        "ENTRY",
        "PROTECT",
        "STOP_AMEND",
        "CLOSE",
        "CANCEL"
      ]
    },
    "mt5_action": {
      "enum": [
        "TRADE_ACTION_PENDING",
        "TRADE_ACTION_DEAL",
        "TRADE_ACTION_SLTP",
        "TRADE_ACTION_REMOVE"
      ]
    },
    "side": {
      "$ref": "urn:ki-trading-v3:common#/$defs/side"
    },
    "qty": {
      "type": "integer",
      "minimum": 1
    },
    "limit_price": {
      "$ref": "urn:ki-trading-v3:common#/$defs/decimal"
    },
    "sl_price": {
      "$ref": "urn:ki-trading-v3:common#/$defs/decimal"
    },
    "time_type": {
      "enum": [
        "ORDER_TIME_SPECIFIED"
      ]
    },
    "expiry_utc": {
      "$ref": "urn:ki-trading-v3:common#/$defs/utc"
    },
    "position_ticket": {
      "$ref": "urn:ki-trading-v3:common#/$defs/ticket"
    },
    "order_ticket": {
      "$ref": "urn:ki-trading-v3:common#/$defs/ticket"
    },
    "magic": {
      "type": "integer",
      "minimum": 0
    },
    "comment": {
      "type": "string",
      "pattern": "^C[0-9A-F]{12}$"
    },
    "risk_decision_ref": {
      "type": "string",
      "minLength": 1
    },
    "grant_id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "PILOT_H5",
        "H5",
        "H10",
        "H15",
        "H20"
      ]
    }
  },
  "required": [
    "schema_version",
    "message_id",
    "correlation_id",
    "producer",
    "created_utc",
    "command_id",
    "payload_sha256",
    "account_ref",
    "mode",
    "instrument_id",
    "broker_symbol",
    "strategy_id",
    "order_kind",
    "mt5_action",
    "magic",
    "comment",
    "risk_decision_ref",
    "grant_id",
    "profile"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "order_kind": {
            "const": "ENTRY"
          }
        },
        "required": [
          "order_kind"
        ]
      },
      "then": {
        "required": [
          "side",
          "qty",
          "limit_price",
          "time_type",
          "expiry_utc",
          "sl_price"
        ],
        "properties": {
          "mt5_action": {
            "const": "TRADE_ACTION_PENDING"
          }
        },
        "not": {
          "required": [
            "position_ticket"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "order_kind": {
            "const": "CLOSE"
          }
        },
        "required": [
          "order_kind"
        ]
      },
      "then": {
        "required": [
          "side",
          "qty",
          "position_ticket"
        ],
        "properties": {
          "mt5_action": {
            "const": "TRADE_ACTION_DEAL"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "order_kind": {
            "enum": [
              "PROTECT",
              "STOP_AMEND"
            ]
          }
        },
        "required": [
          "order_kind"
        ]
      },
      "then": {
        "required": [
          "position_ticket",
          "sl_price"
        ],
        "properties": {
          "mt5_action": {
            "const": "TRADE_ACTION_SLTP"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "order_kind": {
            "const": "CANCEL"
          }
        },
        "required": [
          "order_kind"
        ]
      },
      "then": {
        "required": [
          "order_ticket"
        ],
        "properties": {
          "mt5_action": {
            "const": "TRADE_ACTION_REMOVE"
          }
        }
      }
    }
  ]
}
